---
import { render, type CollectionEntry } from 'astro:content';
import Links from './Links.astro';

interface Props { project: CollectionEntry<'projects'>; featured?: boolean }
const { project, featured = false } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const summary = featured ? (data.featuredSummary ?? data.summary) : data.summary;
---

<article class="project" data-category={featured ? undefined : data.categories.join(' ')}>
  <h3>
    {data.url ? <a href={data.url}>{data.title} {data.url.endsWith('.html') ? '→' : '↗'}</a> : data.title}
  </h3>
  {summary ? <p>{summary}</p> : <Content />}
  <p class="tech">{data.technologies.join(' · ')}</p>
  <Links links={data.links} />
</article>
